# Claude Code uses your existing `claude` CLI login - no key needed here.
# Just make sure `claude` is on PATH and you're logged in.

# Gemini - prefer `npm install -g @google/gemini-cli` and log in with your
# Google account (no key needed, covers a Gemini subscription's usage).
# This is only a fallback if you'd rather use a plain API key instead:
# free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GitHub Copilot - `npm install -g @github/copilot` and log in with your
# GitHub account (no key - needs a Copilot plan). No env var fallback here.

# Everything else (DeepSeek, Groq, OpenRouter, Cerebras, Mistral, OpenAI, or
# any other OpenAI-compatible endpoint) is added via the CLI/menu, not by
# hand-editing this file - it writes the right <NAME>_API_KEY line here for
# you and the rest of the config to .orchestrator/providers.json:
#   orchestrator settings add deepseek
#   orchestrator settings add-account groq --label personal   (a 2nd account,
#     pooled with round-robin + failover - handy for stacking free-tier limits)
# See `orchestrator settings presets` for what's available.

# Local <-> cloud balance ("the slider"): 0 = always escalate to cloud
# (max precision), 10 = always try local first (max savings), 5 = balanced
# default. Set via `orchestrator settings bias <0-10>` or the menu instead
# of hand-editing this, but it's just a plain env var:
LOCAL_BIAS=5

# Ollama (local, free) - used for "low complexity" plan steps to save tokens.
# 32b is a big model: ~20GB download, wants 24GB+ RAM/VRAM to run comfortably.
# Drop to qwen2.5-coder:7b in here if it's too slow/heavy on this machine.
# Once you register named hosts (`orchestrator settings add-host`), these
# two are ignored - they're only the fallback for a single unnamed machine.
OLLAMA_MODEL=qwen2.5-coder:32b

# Single machine: leave OLLAMA_HOSTS unset, this is used.
OLLAMA_HOST=http://localhost:11434

# Two PCs pooling GPUs over your LAN: put both machines on a Tailscale
# (or other WireGuard) network first - NEVER port-forward 11434 to the
# internet, Ollama has no built-in auth. Then list both Tailscale IPs here,
# comma-separated, and OLLAMA_HOSTS takes over from OLLAMA_HOST.
# OLLAMA_HOSTS=http://100.x.y.1:11434,http://100.x.y.2:11434

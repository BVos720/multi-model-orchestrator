# Claude Code uses your existing `claude` CLI login - no key needed here.
# Just make sure `claude` is on PATH and you're logged in.

# Gemini - free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: any OpenAI-compatible provider (OpenAI, Groq, OpenRouter, ...)
# Leave OPENAI_API_KEY blank to skip this agent entirely.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama (local, free) - used for "low complexity" plan steps to save tokens.
# 32b is a big model: ~20GB download, wants 24GB+ RAM/VRAM to run comfortably.
# Drop to qwen2.5-coder:7b in here if it's too slow/heavy on this machine.
OLLAMA_MODEL=qwen2.5-coder:32b

# Single machine: leave OLLAMA_HOSTS unset, this is used.
OLLAMA_HOST=http://localhost:11434

# Two PCs pooling GPUs over your LAN: put both machines on a Tailscale
# (or other WireGuard) network first - NEVER port-forward 11434 to the
# internet, Ollama has no built-in auth. Then list both Tailscale IPs here,
# comma-separated, and OLLAMA_HOSTS takes over from OLLAMA_HOST.
# OLLAMA_HOSTS=http://100.x.y.1:11434,http://100.x.y.2:11434
